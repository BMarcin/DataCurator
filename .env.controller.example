# Controller (run_controller.py) — the admin CLI: seed / status / rerun /
# cancel / gc. Short-lived, run by hand. Normally invoked on the coordination
# box (next to the monitor), so NATS is reached on localhost in plaintext; run
# it off-box instead and use the worker's public tls:// values.
# Copy to `.env.controller`. Never commit `.env.controller`. Run with:
#   uv run --env-file .env.controller python run_controller.py
# NOTE: for blank values, keep explanatory text on its OWN line — an inline
# `# comment` after `KEY=` is parsed as the value by python-dotenv.

# -- NATS: the local nats container, published to the host in plaintext --------
NATS_URL=nats://localhost:4222
NATS_USER=controller
NATS_PASSWORD=
NATS_TLS_FIRST=0

# -- S3: the pipeline data bucket ---------------------------------------------
# seed uploads the input chunks and renders per-stage YAML here; match the
# values the workers and monitor use so every role addresses the same data.
JOB_S3_ENDPOINT=https://s3.example.eu
JOB_S3_REGION=garage
JOB_S3_ACCESS_KEY_ID=
JOB_S3_SECRET_ACCESS_KEY=
DC_S3_BUCKET=
DC_S3_PREFIX=pipeline
# DC_S3_RETRIES / DC_S3_RETRY_MAX_WAIT: attempts per S3 call on a transient
# failure (default 6) and the cap on one backoff sleep in seconds (default 60).
DC_S3_RETRIES=
DC_S3_RETRY_MAX_WAIT=

# -- Version ------------------------------------------------------------------
# The controller stamps DC_VERSION onto the job at seed time, and workers must
# match it. Without it the controller uses this checkout's short git sha, which
# no released worker image has, so add DC_VERSION=<release tag> to your copy.

# -- Seed concurrency ---------------------------------------------------------
# seed uploads input chunks and publishes stage-0 messages — both are one
# network round-trip per chunk, issued concurrently. Raise these if the S3
# endpoint / NATS server can take more in flight.
DC_SEED_UPLOAD_CONCURRENCY=16    # concurrent S3 PUTs (also sizes the S3 pool)
DC_SEED_PUBLISH_CONCURRENCY=32   # concurrent JetStream publishes
