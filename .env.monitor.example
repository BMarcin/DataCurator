# Monitor, on the coordination box (distributed-infra/). Copy to `.env.monitor`
# in the repo root; the monitor container reads it via env_file.
# Never commit `.env.monitor`.
# NOTE: for blank values, keep explanatory text on its OWN line — an inline
# `# comment` after `KEY=` is parsed as the value by python-dotenv.

# -- NATS: talk to the local nats container in plaintext ----------------------
# The compose overrides NATS_URL/NATS_TLS_FIRST for the monitor container
# (nats://nats:4222, in-network). These values are for a monitor run on the host
# — the container publishes 4222 to the host, so localhost, no TLS.
NATS_URL=nats://localhost:4222
NATS_USER=monitor
NATS_PASSWORD=
NATS_TLS_FIRST=0

# -- S3: the pipeline data bucket ---------------------------------------------
JOB_S3_ENDPOINT=https://s3.example.eu
JOB_S3_REGION=garage
JOB_S3_ACCESS_KEY_ID=
JOB_S3_SECRET_ACCESS_KEY=
DC_S3_BUCKET=
DC_S3_PREFIX=pipeline

# -- Monitor settings ---------------------------------------------------------
# DC_MONITOR_PORT: /metrics (+ /api); pick a free port (traefik often owns 8080).
DC_MONITOR_PORT=8080
# DC_PANEL_TOKEN: static bearer token for the monitor's /api.
DC_PANEL_TOKEN=

# -- Optional alerts (config/notifications/ntfy.yaml) -------------------------
# DC_NTFY_TOPIC: monitor alerts topic; server/token in NTFY_URL/NTFY_TOKEN.
DC_NTFY_TOPIC=
NTFY_URL=
NTFY_TOKEN=
# DC_STALL_CRON: unset = one stall ntfy per (job,stage) per hour. Set a cron
# expression (evaluated in the monitor's local/container TZ) to batch every
# stalled stage into a single digest on that schedule, e.g. "0 * * * *".
DC_STALL_CRON=
# DC_NTFY_PRIORITY_<KIND>: ntfy priority per alert kind (min|low|default|high|urgent).
# Kinds/defaults: DEAD_LETTER=high GHOST=urgent STALL=high FLAGGED=default
# REDELIVERY=default COMPLETE=default. Unset = the default.
DC_NTFY_PRIORITY_DEAD_LETTER=
