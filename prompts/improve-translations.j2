TARGET: Ustaw minutnik na dwa minuty.
{% if google_translation %}REFERENCE: Ustaw minutnik na dwie minuty.
{% endif %}LANGUAGETOOL FINDINGS:
- Błąd odmiany. Prawdopodobnie powinno być: dwie minuty.
  error_text: dwa minuty
  context: Ustaw minutnik na dwa minuty.
  suggestions: dwie minuty

OUTPUT:
{
  "overall_quality": "acceptable",
  "languagetool_evaluations": [
