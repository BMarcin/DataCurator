      "finding_message": "Błąd odmiany. Prawdopodobnie powinno być: dwie minuty.",
      "is_real_issue": true,
      "reason": "LanguageTool flagged a Polish inflection error.{% if google_translation %} The REFERENCE uses the correctly inflected form 'dwie minuty' for the same word, corroborating the finding.{% endif %} Accepted as a real inflection error."
    }
  ],
  "issues": [
    {
      "category": "linguistic_conventions",
      "severity": "major",
      "span_in_target": "dwa minuty",
      "explanation": "Wrong gender agreement. The noun 'minuta' is feminine, so the numeral must be 'dwie', not the masculine/neuter 'dwa'.{% if google_translation %} The REFERENCE uses the correctly inflected form.{% endif %}",
      "suggested_fix": "dwie minuty"
    }
  ],
  "improved_primary": "Ustaw minutnik na dwie minuty.",
