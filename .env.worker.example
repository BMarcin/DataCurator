# Worker node (run_distributed.py) — a box that pulls and runs chunks.
# Copy to `.env.worker` on the worker box and fill in. Never commit `.env.worker`.
# NOTE: for blank values, keep explanatory text on its OWN line — an inline
# `# comment` after `KEY=` is parsed as the value by python-dotenv.

# -- NATS: the coordination server, reached over the public internet ----------
# TLS terminates at the proxy in front of NATS, so use a tls:// URL and
# NATS_TLS_FIRST=1. User/password are issued to you by the operator.
NATS_URL=tls://nats.example.eu
NATS_USER=
NATS_PASSWORD=
NATS_TLS_FIRST=1

# -- S3: the pipeline data bucket (must be reachable from this box) -----------
# Connection reuses the JOB_S3_* names; DC_S3_BUCKET/DC_S3_PREFIX select where
# job data lives. Match the values the controller was seeded with.
JOB_S3_ENDPOINT=https://s3.example.eu
JOB_S3_REGION=garage
JOB_S3_ACCESS_KEY_ID=
JOB_S3_SECRET_ACCESS_KEY=
DC_S3_BUCKET=
DC_S3_PREFIX=pipeline
# DC_S3_RETRIES / DC_S3_RETRY_MAX_WAIT: attempts per S3 call on a transient
# failure (default 6) and the cap on one backoff sleep in seconds (default 60).
DC_S3_RETRIES=
DC_S3_RETRY_MAX_WAIT=

# -- Worker settings ----------------------------------------------------------
# DC_BINDINGS_FILE: LLM/LanguageTool endpoints (see bindings.example.yaml);
# omit the file for a cpu-only worker (no LLM stages).
DC_BINDINGS_FILE=bindings.yaml
# DC_WORKER_ID: fleet node name (default: hostname).
DC_WORKER_ID=
# DC_WORKER_CONCURRENCY: in-flight records.
DC_WORKER_CONCURRENCY=32
# DC_VERSION is built into the worker image as its release tag. To override it,
# add DC_VERSION=<version> to your copy. It must equal the controller's value,
# and a blank one counts as an override too.
# DC_LOKI_URL: optional, e.g. http://obs.lan:3100 (fail-open WARNING+ sink).
DC_LOKI_URL=
