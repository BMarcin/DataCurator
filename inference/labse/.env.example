# LaBSE embedding service configuration.
# (python-dotenv parses `KEY=value`; keep comments on their own lines — an
# inline `# ...` after a value is read as part of the value.)

# Any model producing a shared multilingual sentence space works; LaBSE is the
# default from the wiki (768-dim).
LABSE_MODEL=sentence-transformers/LaBSE

# Truncate inputs to this many tokens. Unset -> the model's own default.
# LABSE_MAX_SEQ_LENGTH=256

# float32 (default) | float16 | bfloat16. fp16/bf16 halve VRAM + latency on GPU;
# keep float32 for a CPU run.
LABSE_DTYPE=float32

# Optional explicit device (else: cuda if available, otherwise cpu).
# LABSE_DEVICE=cuda
# Pin the service to one GPU on a multi-GPU host.
CUDA_VISIBLE_DEVICES=0

LABSE_PORT=8000

# Dynamic batching: coalesce concurrently-submitted texts up to MAX_BATCH_SIZE
# items or MAX_BATCH_WAIT_MS milliseconds, whichever comes first.
MAX_BATCH_SIZE=64
MAX_BATCH_WAIT_MS=8

# Optional bearer token. Leave blank to leave the service open (internal LAN).
LABSE_TOKEN=

# Public hostname Traefik routes to this service.
LABSE_PUBLIC_HOST=labse.example.com
