# MetricX inference service configuration.
# (python-dotenv parses `KEY=value`; keep comments on their own lines — an
# inline `# ...` after a value is read as part of the value.)

# QE (source+hypothesis). For the reference-based 3-input model use
# google/metricx-24-hybrid-xl-v2p6 instead.
METRICX_MODEL=google/metricx-23-qe-xl-v2p0
METRICX_TOKENIZER=google/mt5-xl

# metricx-23-qe | metricx-24-hybrid; auto-detected from METRICX_MODEL if unset.
# METRICX_VARIANT=metricx-24-hybrid

# Defaults to the length the variant was trained with (23: 1024, 24: 1536).
# METRICX_MAX_INPUT_LENGTH=1024

# float32 (default, reproduces the offline eval numbers) | float16 | bfloat16
METRICX_DTYPE=float32

# Optional explicit device (else: cuda if available, otherwise cpu).
# METRICX_DEVICE=cuda
# Pin the service to one GPU on a multi-GPU host.
CUDA_VISIBLE_DEVICES=0

METRICX_PORT=8000

# Dynamic batching: coalesce concurrently-submitted pairs up to MAX_BATCH_SIZE
# items or MAX_BATCH_WAIT_MS milliseconds, whichever comes first.
MAX_BATCH_SIZE=64
MAX_BATCH_WAIT_MS=8

# Optional bearer token. Leave blank to leave the service open (internal LAN).
METRICX_TOKEN=

# Public hostname Traefik routes to this service.
METRICX_PUBLIC_HOST=metricx.example.com
