# Browse pipeline results in S3 (helpers/browse_jsonl_s3.py).
# Copy to `.env.browse` and fill in. S3 only — no NATS. Never commit `.env.browse`.

# S3-compatible endpoint holding the pipeline data (reuses the JOB_S3_* vars).
JOB_S3_ENDPOINT=https://s3.example.eu
JOB_S3_REGION=garage
JOB_S3_ACCESS_KEY_ID=
JOB_S3_SECRET_ACCESS_KEY=
# Data bucket (falls back to JOB_S3_BUCKET) and the pipeline key prefix.
DC_S3_BUCKET=
DC_S3_PREFIX=pipeline
